# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# Any OpenRouter model that supports tool calling. Free models are rate-limited.
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional: price per 1M tokens (USD) to estimate cost; 0 for free models.
PRICE_INPUT_PER_M=0
PRICE_OUTPUT_PER_M=0
